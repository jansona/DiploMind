# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# logs / data
logs/
save.json
*.save.json

# private configs (keep example/ollama)
conf/*
!conf/example.json
!conf/ollama.json
!conf/mock.json
!conf/aliyun.example.json
!conf/presets/*.json

# Reproducible local playtest output (not source assets)
artifacts/
.pytest_cache/
!conf/presets/
!conf/presets/*.json

# Operator credentials never belong in source bundles.
.env
.env.*
!.env.example
*.pem
*.key
